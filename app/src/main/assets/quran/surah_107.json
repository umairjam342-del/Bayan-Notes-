[{"surahNumber": 107, "ayahNumber": 1, "arabicText": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ", "translation": "بھلا تم نے اس شخص کو دیکھا جو (روزِ) جزا کو جھٹلاتا ہے؟", "tafsirExcerpt": ""}, {"surahNumber": 107, "ayahNumber": 2, "arabicText": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ", "translation": "یہ وہی (بدبخت) ہے، جو یتیم کو دھکے دیتا ہے", "tafsirExcerpt": ""}, {"surahNumber": 107, "ayahNumber": 3, "arabicText": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "translation": "اور فقیر کو کھانا کھلانے کے لیے (لوگوں کو) ترغیب نہیں دیتا", "tafsirExcerpt": ""}, {"surahNumber": 107, "ayahNumber": 4, "arabicText": "فَوَيْلٌۭ لِّلْمُصَلِّينَ", "translation": "تو ایسے نمازیوں کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 107, "ayahNumber": 5, "arabicText": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ", "translation": "جو نماز کی طرف سے غافل رہتے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 107, "ayahNumber": 6, "arabicText": "ٱلَّذِينَ هُمْ يُرَآءُونَ", "translation": "جو ریا کاری کرتے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 107, "ayahNumber": 7, "arabicText": "وَيَمْنَعُونَ ٱلْمَاعُونَ", "translation": "اور برتنے کی چیزیں عاریتہً نہیں دیتے", "tafsirExcerpt": ""}]