[{"surahNumber": 88, "ayahNumber": 1, "arabicText": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "translation": "بھلا تم کو ڈھانپ لینے والی (یعنی قیامت کا) حال معلوم ہوا ہے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 2, "arabicText": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "translation": "اس روز بہت سے منہ (والے) ذلیل ہوں گے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 3, "arabicText": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "translation": "سخت محنت کرنے والے تھکے ماندے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 4, "arabicText": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "translation": "دہکتی آگ میں داخل ہوں گے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 5, "arabicText": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "translation": "ایک کھولتے ہوئے چشمے کا ان کو پانی پلایا جائے گا", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 6, "arabicText": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "translation": "اور خار دار جھاڑ کے سوا ان کے لیے کوئی کھانا نہیں (ہو گا)", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 7, "arabicText": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "translation": "جو نہ فربہی لائے اور نہ بھوک میں کچھ کام آئے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 8, "arabicText": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "translation": "اور بہت سے منہ (والے) اس روز شادماں ہوں گے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 9, "arabicText": "لِّسَعْيِهَا رَاضِيَةٌۭ", "translation": "اپنے اعمال (کی جزا) سے خوش دل", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 10, "arabicText": "فِى جَنَّةٍ عَالِيَةٍۢ", "translation": "بہشت بریں میں", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 11, "arabicText": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "translation": "وہاں کسی طرح کی بکواس نہیں سنیں گے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 12, "arabicText": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "translation": "اس میں چشمے بہ رہے ہوں گے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 13, "arabicText": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "translation": "وہاں تخت ہوں گے اونچے بچھے ہوئے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 14, "arabicText": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "translation": "اور آبخورے (قرینے سے) رکھے ہوئے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 15, "arabicText": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "translation": "اور گاؤ تکیے قطار کی قطار لگے ہوئے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 16, "arabicText": "وَزَرَابِىُّ مَبْثُوثَةٌ", "translation": "اور نفیس مسندیں بچھی ہوئی", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 17, "arabicText": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "translation": "یہ لوگ اونٹوں کی طرف نہیں دیکھتے کہ کیسے (عجیب) پیدا کیے گئے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 18, "arabicText": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "translation": "اور آسمان کی طرف کہ کیسا بلند کیا گیا ہے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 19, "arabicText": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "translation": "اور پہاڑوں کی طرف کہ کس طرح کھڑے کیے گئے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 20, "arabicText": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "translation": "اور زمین کی طرف کہ کس طرح بچھائی گئی", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 21, "arabicText": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "translation": "تو تم نصیحت کرتے رہو کہ تم نصیحت کرنے والے ہی ہو", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 22, "arabicText": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "translation": "تم ان پر داروغہ نہیں ہو", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 23, "arabicText": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "translation": "ہاں جس نے منہ پھیرا اور نہ مانا", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 24, "arabicText": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "translation": "تو خدا اس کو بڑا عذاب دے گا", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 25, "arabicText": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "translation": "بےشک ان کو ہمارے پاس لوٹ کر آنا ہے", "tafsirExcerpt": ""}, {"surahNumber": 88, "ayahNumber": 26, "arabicText": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "translation": "پھر ہم ہی کو ان سے حساب لینا ہے", "tafsirExcerpt": ""}]