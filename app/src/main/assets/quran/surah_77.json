[{"surahNumber": 77, "ayahNumber": 1, "arabicText": "وَٱلْمُرْسَلَٰتِ عُرْفًۭا", "translation": "ہواؤں کی قسم جو نرم نرم چلتی ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 2, "arabicText": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا", "translation": "پھر زور پکڑ کر جھکڑ ہو جاتی ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 3, "arabicText": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا", "translation": "اور (بادلوں کو) پھاڑ کر پھیلا دیتی ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 4, "arabicText": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا", "translation": "پھر ان کو پھاڑ کر جدا جدا کر دیتی ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 5, "arabicText": "فَٱلْمُلْقِيَٰتِ ذِكْرًا", "translation": "پھر فرشتوں کی قسم جو وحی لاتے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 6, "arabicText": "عُذْرًا أَوْ نُذْرًا", "translation": "تاکہ عذر (رفع) کردیا جائے یا ڈر سنا دیا جائے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 7, "arabicText": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ", "translation": "کہ جس بات کا تم سے وعدہ کیا جاتا ہے وہ ہو کر رہے گی", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 8, "arabicText": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ", "translation": "جب تاروں کی چمک جاتی رہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 9, "arabicText": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ", "translation": "اور جب آسمان پھٹ جائے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 10, "arabicText": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ", "translation": "اور جب پہاڑ اُڑے اُڑے پھریں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 11, "arabicText": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ", "translation": "اور جب پیغمبر فراہم کئے جائیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 12, "arabicText": "لِأَىِّ يَوْمٍ أُجِّلَتْ", "translation": "بھلا (ان امور میں) تاخیر کس دن کے لئے کی گئی؟", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 13, "arabicText": "لِيَوْمِ ٱلْفَصْلِ", "translation": "فیصلے کے دن کے لئے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 14, "arabicText": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ", "translation": "اور تمہیں کیا خبر کہ فیصلے کا دن کیا ہے؟", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 15, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کے لئے خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 16, "arabicText": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ", "translation": "کیا ہم نے پہلے لوگوں کو ہلاک نہیں کر ڈالا", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 17, "arabicText": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ", "translation": "پھر ان پچھلوں کو بھی ان کے پیچھے بھیج دیتے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 18, "arabicText": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "translation": "ہم گنہگاروں کے ساتھ ایسا ہی کیا کرتے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 19, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 20, "arabicText": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ", "translation": "کیا ہم نے تم کو حقیر پانی سے نہیں پیدا کیا؟", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 21, "arabicText": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ", "translation": "اس کو ایک محفوظ جگہ میں رکھا", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 22, "arabicText": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ", "translation": "ایک وقت معین تک", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 23, "arabicText": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ", "translation": "پھر اندازہ مقرر کیا اور ہم کیا ہی خوب اندازہ مقرر کرنے والے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 24, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 25, "arabicText": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا", "translation": "کیا ہم نے زمین کو سمیٹنے والی نہیں بنایا", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 26, "arabicText": "أَحْيَآءًۭ وَأَمْوَٰتًۭا", "translation": "یعنی) زندوں اور مردوں کو", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 27, "arabicText": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا", "translation": "(بنایا) اور اس پر اونچے اونچے پہاڑ رکھ دیئے اور تم لوگوں کو میٹھا پانی پلایا", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 28, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 29, "arabicText": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ", "translation": "جس چیز کو تم جھٹلایا کرتے تھے۔ (اب) اس کی طرف چلو", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 30, "arabicText": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ", "translation": "(یعنی) اس سائے کی طرف چلو جس کی تین شاخیں ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 31, "arabicText": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ", "translation": "نہ ٹھنڈی چھاؤں اور نہ لپٹ سے بچاؤ", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 32, "arabicText": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ", "translation": "اس سے (آگ کی اتنی اتنی بڑی) چنگاریاں اُڑتی ہیں جیسے محل", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 33, "arabicText": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ", "translation": "گویا زرد رنگ کے اونٹ ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 34, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 35, "arabicText": "هَٰذَا يَوْمُ لَا يَنطِقُونَ", "translation": "یہ وہ دن ہے کہ (لوگ) لب تک نہ ہلا سکیں گے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 36, "arabicText": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ", "translation": "اور نہ ان کو اجازت دی جائے گی کہ عذر کرسکیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 37, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 38, "arabicText": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ", "translation": "یہی فیصلے کا دن ہے (جس میں) ہم نے تم کو اور پہلے لوگوں کو جمع کیا ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 39, "arabicText": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ", "translation": "اگر تم کو کوئی داؤں آتا ہو تو مجھ سے کر لو", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 40, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 41, "arabicText": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ", "translation": "بےشک پرہیزگار سایوں اور چشموں میں ہوں گے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 42, "arabicText": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ", "translation": "اور میؤوں میں جو ان کو مرغوب ہوں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 43, "arabicText": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "translation": "اور جو عمل تم کرتے رہے تھے ان کے بدلے میں مزے سے کھاؤ اور پیو", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 44, "arabicText": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "translation": "ہم نیکو کاروں کو ایسا ہی بدلہ دیا کرتے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 45, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کی خرابی ہوگی", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 46, "arabicText": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ", "translation": "(اے جھٹلانے والو!) تم کسی قدر کھا لو اور فائدے اُٹھا لو تم بےشک گنہگار ہو", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 47, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 48, "arabicText": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ", "translation": "اور جب ان سے کہا جاتا ہے کہ (خدا کے آگے) جھکو تو جھکتے نہیں", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 49, "arabicText": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "translation": "اس دن جھٹلانے والوں کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 77, "ayahNumber": 50, "arabicText": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ", "translation": "اب اس کے بعد یہ کون سی بات پر ایمان لائیں گے؟", "tafsirExcerpt": ""}]