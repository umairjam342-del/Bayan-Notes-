[{"surahNumber": 81, "ayahNumber": 1, "arabicText": "إِذَا ٱلشَّمْسُ كُوِّرَتْ", "translation": "جب سورج لپیٹ لیا جائے گا", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 2, "arabicText": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "translation": "جب تارے بےنور ہو جائیں گے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 3, "arabicText": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "translation": "اور جب پہاڑ چلائے جائیں گے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 4, "arabicText": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "translation": "اور جب بیانے والی اونٹنیاں بےکار ہو جائیں گی", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 5, "arabicText": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "translation": "اور جب وحشی جانور جمع اکٹھے ہو جائیں گے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 6, "arabicText": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "translation": "اور جب دریا آگ ہو جائیں گے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 7, "arabicText": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "translation": "اور جب روحیں (بدنوں سے) ملا دی جائیں گی", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 8, "arabicText": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "translation": "اور جب لڑکی سے جو زندہ دفنا دی گئی ہو پوچھا جائے گا", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 9, "arabicText": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "translation": "کہ وہ کس گناہ پرماری گئی", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 10, "arabicText": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "translation": "اور جب (عملوں کے) دفتر کھولے جائیں گے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 11, "arabicText": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "translation": "اور جب آسمانوں کی کھال کھینچ لی جائے گی", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 12, "arabicText": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "translation": "اور جب دوزخ (کی آگ) بھڑکائی جائے گی", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 13, "arabicText": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "translation": "اور بہشت جب قریب لائی جائے گی", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 14, "arabicText": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "translation": "تب ہر شخص معلوم کر لے گا کہ وہ کیا لے کر آیا ہے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 15, "arabicText": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "translation": "ہم کو ان ستاروں کی قسم جو پیچھے ہٹ جاتے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 16, "arabicText": "ٱلْجَوَارِ ٱلْكُنَّسِ", "translation": "(اور) جو سیر کرتے اور غائب ہو جاتے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 17, "arabicText": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "translation": "اور رات کی قسم جب ختم ہونے لگتی ہے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 18, "arabicText": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "translation": "اور صبح کی قسم جب نمودار ہوتی ہے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 19, "arabicText": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "translation": "کہ بےشک یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 20, "arabicText": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "translation": "جو صاحب قوت مالک عرش کے ہاں اونچے درجے والا ہے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 21, "arabicText": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "translation": "سردار (اور) امانت دار ہے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 22, "arabicText": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "translation": "اور (مکے والو) تمہارے رفیق (یعنی محمدﷺ) دیوانے نہیں ہیں", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 23, "arabicText": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "translation": "بےشک انہوں نے اس (فرشتے) کو (آسمان کے کھلے یعنی) مشرقی کنارے پر دیکھا ہے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 24, "arabicText": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "translation": "اور وہ پوشیدہ باتوں (کے ظاہر کرنے) میں بخیل نہیں", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 25, "arabicText": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "translation": "اور یہ شیطان مردود کا کلام نہیں", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 26, "arabicText": "فَأَيْنَ تَذْهَبُونَ", "translation": "پھر تم کدھر جا رہے ہو", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 27, "arabicText": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "translation": "یہ تو جہان کے لوگوں کے لیے نصیحت ہے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 28, "arabicText": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "translation": "(یعنی) اس کے لیے جو تم میں سے سیدھی چال چلنا چاہے", "tafsirExcerpt": ""}, {"surahNumber": 81, "ayahNumber": 29, "arabicText": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "translation": "اور تم کچھ بھی نہیں چاہ سکتے مگر وہی جو خدائے رب العالمین چاہے", "tafsirExcerpt": ""}]