[{"surahNumber": 108, "ayahNumber": 1, "arabicText": "إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ", "translation": "(اے محمدﷺ) ہم نے تم کو کوثر عطا فرمائی ہے", "tafsirExcerpt": ""}, {"surahNumber": 108, "ayahNumber": 2, "arabicText": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ", "translation": "تو اپنے پروردگار کے لیے نماز پڑھا کرو اور قربانی دیا کرو", "tafsirExcerpt": ""}, {"surahNumber": 108, "ayahNumber": 3, "arabicText": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ", "translation": "کچھ شک نہیں کہ تمہارا دشمن ہی بےاولاد رہے گا", "tafsirExcerpt": ""}]