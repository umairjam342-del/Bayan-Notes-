[{"surahNumber": 92, "ayahNumber": 1, "arabicText": "وَٱلَّيْلِ إِذَا يَغْشَىٰ", "translation": "رات کی قسم جب (دن کو) چھپالے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 2, "arabicText": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "translation": "اور دن کی قسم جب چمک اٹھے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 3, "arabicText": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "translation": "اور اس (ذات) کی قسم جس نے نر اور مادہ پیدا کیے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 4, "arabicText": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "translation": "کہ تم لوگوں کی کوششں طرح طرح کی ہے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 5, "arabicText": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "translation": "تو جس نے (خدا کے رستے میں مال) دیا اور پرہیز گاری کی", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 6, "arabicText": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "translation": "اور نیک بات کو سچ جانا", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 7, "arabicText": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "translation": "اس کو ہم آسان طریقے کی توفیق دیں گے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 8, "arabicText": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "translation": "اور جس نے بخل کیا اور بےپروا بنا رہا", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 9, "arabicText": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "translation": "اور نیک بات کو جھوٹ سمجھا", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 10, "arabicText": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "translation": "اسے سختی میں پہنچائیں گے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 11, "arabicText": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "translation": "اور جب وہ (دوزخ کے گڑھے میں) گرے گا تو اس کا مال اس کے کچھ کام نہ آئے گا", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 12, "arabicText": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "translation": "ہمیں تو راہ دکھا دینا ہے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 13, "arabicText": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "translation": "اور آخرت او ردنیا ہماری ہی چیزیں ہیں", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 14, "arabicText": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "translation": "سو میں نے تم کو بھڑکتی آگ سے متنبہ کر دیا", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 15, "arabicText": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "translation": "اس میں وہی داخل ہو گا جو بڑا بدبخت ہے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 16, "arabicText": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "translation": "جس نے جھٹلایا اور منہ پھیرا", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 17, "arabicText": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "translation": "اور جو بڑا پرہیزگار ہے وہ (اس سے) بچا لیا جائے گا", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 18, "arabicText": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "translation": "جو مال دیتا ہے تاکہ پاک ہو", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 19, "arabicText": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "translation": "اور (اس لیے) نہیں (دیتا کہ) اس پر کسی کا احسان (ہے) جس کا وہ بدلہ اتارتا ہے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 20, "arabicText": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "translation": "بلکہ اپنے خداوند اعلیٰ کی رضامندی حاصل کرنے کے لیے دیتا ہے", "tafsirExcerpt": ""}, {"surahNumber": 92, "ayahNumber": 21, "arabicText": "وَلَسَوْفَ يَرْضَىٰ", "translation": "اور وہ عنقریب خوش ہو جائے گا", "tafsirExcerpt": ""}]