[{"surahNumber": 86, "ayahNumber": 1, "arabicText": "وَٱلسَّمَآءِ وَٱلطَّارِقِ", "translation": "آسمان اور رات کے وقت آنے والے کی قسم", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 2, "arabicText": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "translation": "اور تم کو کیا معلوم کہ رات کے وقت آنے والا کیا ہے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 3, "arabicText": "ٱلنَّجْمُ ٱلثَّاقِبُ", "translation": "وہ تارا ہے چمکنے والا", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 4, "arabicText": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "translation": "کہ کوئی متنفس نہیں جس پر نگہبان مقرر نہیں", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 5, "arabicText": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "translation": "تو انسان کو دیکھنا چاہئے کہ وہ کاہے سے پیدا ہوا ہے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 6, "arabicText": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "translation": "وہ اچھلتے ہوئے پانی سے پیدا ہوا ہے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 7, "arabicText": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "translation": "جو پیٹھ اور سینے کے بیچ میں سے نکلتا ہے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 8, "arabicText": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "translation": "بےشک خدا اس کے اعادے (یعنی پھر پیدا کرنے) پر قادر ہے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 9, "arabicText": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "translation": "جس دن دلوں کے بھید جانچے جائیں گے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 10, "arabicText": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "translation": "تو انسان کی کچھ پیش نہ چل سکے گی اور نہ کوئی اس کا مددگار ہو گا", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 11, "arabicText": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "translation": "آسمان کی قسم جو مینہ برساتا ہے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 12, "arabicText": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "translation": "اور زمین کی قسم جو پھٹ جاتی ہے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 13, "arabicText": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "translation": "کہ یہ کلام (حق کو باطل سے) جدا کرنے والا ہے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 14, "arabicText": "وَمَا هُوَ بِٱلْهَزْلِ", "translation": "اور بیہودہ بات نہیں ہے", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 15, "arabicText": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "translation": "یہ لوگ تو اپنی تدبیروں میں لگ رہے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 16, "arabicText": "وَأَكِيدُ كَيْدًۭا", "translation": "اور ہم اپنی تدبیر کر رہے ہیں", "tafsirExcerpt": ""}, {"surahNumber": 86, "ayahNumber": 17, "arabicText": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "translation": "تو تم کافروں کو مہلت دو بس چند روز ہی مہلت دو", "tafsirExcerpt": ""}]