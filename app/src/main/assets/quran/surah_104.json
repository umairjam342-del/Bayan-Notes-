[{"surahNumber": 104, "ayahNumber": 1, "arabicText": "وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ", "translation": "ہر طعن آمیز اشارتیں کرنے والے چغل خور کی خرابی ہے", "tafsirExcerpt": ""}, {"surahNumber": 104, "ayahNumber": 2, "arabicText": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ", "translation": "جو مال جمع کرتا اور اس کو گن گن کر رکھتا ہے", "tafsirExcerpt": ""}, {"surahNumber": 104, "ayahNumber": 3, "arabicText": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ", "translation": "(اور) خیال کرتا ہے کہ اس کا مال اس کی ہمیشہ کی زندگی کا موجب ہو گا", "tafsirExcerpt": ""}, {"surahNumber": 104, "ayahNumber": 4, "arabicText": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ", "translation": "ہر گز نہیں وہ ضرور حطمہ میں ڈالا جائے گا", "tafsirExcerpt": ""}, {"surahNumber": 104, "ayahNumber": 5, "arabicText": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ", "translation": "اور تم کیا سمجھے حطمہ کیا ہے؟", "tafsirExcerpt": ""}, {"surahNumber": 104, "ayahNumber": 6, "arabicText": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ", "translation": "وہ خدا کی بھڑکائی ہوئی آگ ہے", "tafsirExcerpt": ""}, {"surahNumber": 104, "ayahNumber": 7, "arabicText": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ", "translation": "جو دلوں پر جا لپٹے گی", "tafsirExcerpt": ""}, {"surahNumber": 104, "ayahNumber": 8, "arabicText": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ", "translation": "(اور) وہ اس میں بند کر دیئے جائیں گے", "tafsirExcerpt": ""}, {"surahNumber": 104, "ayahNumber": 9, "arabicText": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ", "translation": "(یعنی آگ کے) لمبے لمبے ستونوں میں", "tafsirExcerpt": ""}]