[{"surahNumber": 80, "ayahNumber": 1, "arabicText": "عَبَسَ وَتَوَلَّىٰٓ", "translation": "(محمد مصطفٰےﷺ) ترش رُو ہوئے اور منہ پھیر بیٹھے", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 2, "arabicText": "أَن جَآءَهُ ٱلْأَعْمَىٰ", "translation": "کہ ان کے پاس ایک نابینا آیا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 3, "arabicText": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ", "translation": "اور تم کو کیا خبر شاید وہ پاکیزگی حاصل کرتا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 4, "arabicText": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ", "translation": "یا سوچتا تو سمجھانا اسے فائدہ دیتا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 5, "arabicText": "أَمَّا مَنِ ٱسْتَغْنَىٰ", "translation": "جو پروا نہیں کرتا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 6, "arabicText": "فَأَنتَ لَهُۥ تَصَدَّىٰ", "translation": "اس کی طرف تو تم توجہ کرتے ہو", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 7, "arabicText": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ", "translation": "حالانکہ اگر وہ نہ سنورے تو تم پر کچھ (الزام) نہیں", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 8, "arabicText": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ", "translation": "اور جو تمہارے پاس دوڑتا ہوا آیا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 9, "arabicText": "وَهُوَ يَخْشَىٰ", "translation": "اور (خدا سے) ڈرتا ہے", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 10, "arabicText": "فَأَنتَ عَنْهُ تَلَهَّىٰ", "translation": "اس سے تم بےرخی کرتے ہو", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 11, "arabicText": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ", "translation": "دیکھو یہ (قرآن) نصیحت ہے", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 12, "arabicText": "فَمَن شَآءَ ذَكَرَهُۥ", "translation": "پس جو چاہے اسے یاد رکھے", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 13, "arabicText": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ", "translation": "قابل ادب ورقوں میں (لکھا ہوا)", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 14, "arabicText": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ", "translation": "جو بلند مقام پر رکھے ہوئے (اور) پاک ہیں", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 15, "arabicText": "بِأَيْدِى سَفَرَةٍۢ", "translation": "لکھنے والوں کے ہاتھوں میں", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 16, "arabicText": "كِرَامٍۭ بَرَرَةٍۢ", "translation": "جو سردار اور نیکو کار ہیں", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 17, "arabicText": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ", "translation": "انسان ہلاک ہو جائے کیسا ناشکرا ہے", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 18, "arabicText": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ", "translation": "اُسے (خدا نے) کس چیز سے بنایا؟", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 19, "arabicText": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "translation": "نطفے سے بنایا پھر اس کا اندازہ مقرر کیا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 20, "arabicText": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ", "translation": "پھر اس کے لیے رستہ آسان کر دیا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 21, "arabicText": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ", "translation": "پھر اس کو موت دی پھر قبر میں دفن کرایا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 22, "arabicText": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ", "translation": "پھر جب چاہے گا اسے اٹھا کھڑا کرے گا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 23, "arabicText": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ", "translation": "کچھ شک نہیں کہ خدا نے اسے جو حکم دیا اس نے اس پر عمل نہ کیا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 24, "arabicText": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ", "translation": "تو انسان کو چاہیئے کہ اپنے کھانے کی طرف نظر کرے", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 25, "arabicText": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا", "translation": "بے شک ہم ہی نے پانی برسایا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 26, "arabicText": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا", "translation": "پھر ہم ہی نے زمین کو چیرا پھاڑا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 27, "arabicText": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا", "translation": "پھر ہم ہی نے اس میں اناج اگایا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 28, "arabicText": "وَعِنَبًۭا وَقَضْبًۭا", "translation": "اور انگور اور ترکاری", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 29, "arabicText": "وَزَيْتُونًۭا وَنَخْلًۭا", "translation": "اور زیتون اور کھجوریں", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 30, "arabicText": "وَحَدَآئِقَ غُلْبًۭا", "translation": "اور گھنے گھنے باغ", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 31, "arabicText": "وَفَٰكِهَةًۭ وَأَبًّۭا", "translation": "اور میوے اور چارا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 32, "arabicText": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "translation": "(یہ سب کچھ) تمہارے اور تمہارے چارپایوں کے لیے بنایا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 33, "arabicText": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ", "translation": "تو جب (قیامت کا) غل مچے گا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 34, "arabicText": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ", "translation": "اس دن آدمی اپنے بھائی سے دور بھاگے گا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 35, "arabicText": "وَأُمِّهِۦ وَأَبِيهِ", "translation": "اور اپنی ماں اور اپنے باپ سے", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 36, "arabicText": "وَصَٰحِبَتِهِۦ وَبَنِيهِ", "translation": "اور اپنی بیوی اور اپنے بیٹے سے", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 37, "arabicText": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ", "translation": "ہر شخص اس روز ایک فکر میں ہو گا جو اسے (مصروفیت کے لیے) بس کرے گا", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 38, "arabicText": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ", "translation": "اور کتنے منہ اس روز چمک رہے ہوں گے", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 39, "arabicText": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ", "translation": "خنداں و شاداں (یہ مومنان نیکو کار ہیں)", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 40, "arabicText": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ", "translation": "اور کتنے منہ ہوں گے جن پر گرد پڑ رہی ہو گی", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 41, "arabicText": "تَرْهَقُهَا قَتَرَةٌ", "translation": "(اور) سیاہی چڑھ رہی ہو گی", "tafsirExcerpt": ""}, {"surahNumber": 80, "ayahNumber": 42, "arabicText": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ", "translation": "یہ کفار بدکردار ہیں", "tafsirExcerpt": ""}]