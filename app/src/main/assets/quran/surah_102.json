[{"surahNumber": 102, "ayahNumber": 1, "arabicText": "أَلْهَىٰكُمُ ٱلتَّكَاثُرُ", "translation": "(لوگو) تم کو (مال کی) بہت سی طلب نے غافل کر دیا", "tafsirExcerpt": ""}, {"surahNumber": 102, "ayahNumber": 2, "arabicText": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ", "translation": "یہاں تک کہ تم نے قبریں جا دیکھیں", "tafsirExcerpt": ""}, {"surahNumber": 102, "ayahNumber": 3, "arabicText": "كَلَّا سَوْفَ تَعْلَمُونَ", "translation": "دیکھو تمہیں عنقریب معلوم ہو جائے گا", "tafsirExcerpt": ""}, {"surahNumber": 102, "ayahNumber": 4, "arabicText": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ", "translation": "پھر دیکھو تمہیں عنقریب معلوم ہو جائے گا", "tafsirExcerpt": ""}, {"surahNumber": 102, "ayahNumber": 5, "arabicText": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ", "translation": "دیکھو اگر تم جانتے (یعنی) علم الیقین (رکھتے تو غفلت نہ کرتے)", "tafsirExcerpt": ""}, {"surahNumber": 102, "ayahNumber": 6, "arabicText": "لَتَرَوُنَّ ٱلْجَحِيمَ", "translation": "تم ضرور دوزخ کو دیکھو گے", "tafsirExcerpt": ""}, {"surahNumber": 102, "ayahNumber": 7, "arabicText": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ", "translation": "پھر اس کو (ایسا) دیکھو گے (کہ) عین الیقین (آ جائے گا)", "tafsirExcerpt": ""}, {"surahNumber": 102, "ayahNumber": 8, "arabicText": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ", "translation": "پھر اس روز تم سے (شکر) نعمت کے بارے میں پرسش ہو گی", "tafsirExcerpt": ""}]