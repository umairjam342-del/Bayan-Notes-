[{"surahNumber": 101, "ayahNumber": 1, "arabicText": "ٱلْقَارِعَةُ", "translation": "کھڑ کھڑانے والی", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 2, "arabicText": "مَا ٱلْقَارِعَةُ", "translation": "کھڑ کھڑانے والی کیا ہے؟", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 3, "arabicText": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "translation": "اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 4, "arabicText": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "translation": "(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 5, "arabicText": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "translation": "اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 6, "arabicText": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "translation": "تو جس کے (اعمال کے) وزن بھاری نکلیں گے", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 7, "arabicText": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "translation": "وہ دل پسند عیش میں ہو گا", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 8, "arabicText": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "translation": "اور جس کے وزن ہلکے نکلیں گے", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 9, "arabicText": "فَأُمُّهُۥ هَاوِيَةٌۭ", "translation": "اس کا مرجع ہاویہ ہے", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 10, "arabicText": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "translation": "اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟", "tafsirExcerpt": ""}, {"surahNumber": 101, "ayahNumber": 11, "arabicText": "نَارٌ حَامِيَةٌۢ", "translation": "دہکتی ہوئی آگ ہے", "tafsirExcerpt": ""}]