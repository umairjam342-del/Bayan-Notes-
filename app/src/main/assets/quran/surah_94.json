[{"surahNumber": 94, "ayahNumber": 1, "arabicText": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ", "translation": "(اے محمدﷺ) کیا ہم نے تمہارا سینہ کھول نہیں دیا؟ (بےشک کھول دیا)", "tafsirExcerpt": ""}, {"surahNumber": 94, "ayahNumber": 2, "arabicText": "وَوَضَعْنَا عَنكَ وِزْرَكَ", "translation": "اور تم پر سے بوجھ بھی اتار دیا", "tafsirExcerpt": ""}, {"surahNumber": 94, "ayahNumber": 3, "arabicText": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ", "translation": "جس نے تمہاری پیٹھ توڑ رکھی تھی", "tafsirExcerpt": ""}, {"surahNumber": 94, "ayahNumber": 4, "arabicText": "وَرَفَعْنَا لَكَ ذِكْرَكَ", "translation": "اور تمہارا ذکر بلند کیا", "tafsirExcerpt": ""}, {"surahNumber": 94, "ayahNumber": 5, "arabicText": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا", "translation": "ہاں ہاں مشکل کے ساتھ آسانی بھی ہے", "tafsirExcerpt": ""}, {"surahNumber": 94, "ayahNumber": 6, "arabicText": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا", "translation": "(اور) بے شک مشکل کے ساتھ آسانی ہے", "tafsirExcerpt": ""}, {"surahNumber": 94, "ayahNumber": 7, "arabicText": "فَإِذَا فَرَغْتَ فَٱنصَبْ", "translation": "تو جب فارغ ہوا کرو تو (عبادت میں) محنت کیا کرو", "tafsirExcerpt": ""}, {"surahNumber": 94, "ayahNumber": 8, "arabicText": "وَإِلَىٰ رَبِّكَ فَٱرْغَب", "translation": "اور اپنے پروردگار کی طرف متوجہ ہو جایا کرو", "tafsirExcerpt": ""}]